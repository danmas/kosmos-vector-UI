# Gemini API Key для Logic Architect
# Скопируйте этот файл в .env и замените YOUR_API_KEY на ваш реальный ключ
VITE_GEMINI_API_KEY=YOUR_API_KEY

# Альтернативно можно использовать VITE_API_KEY
# VITE_API_KEY=YOUR_API_KEY

# File open mode: 'window' | 'tab' | 'dialog'
# window - открывать в новом окне браузера (по умолчанию)
# tab - открывать в новой вкладке браузера
# dialog - открывать во встроенном диалоге приложения
VITE_FILE_OPEN_MODE=window
